NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://soloxsnaps.com

# Existing admin dashboard password auth
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Existing AI/vault features
ANTHROPIC_API_KEY=
OBSIDIAN_VAULT_PATH=

# Shared secret for the Vercel Cron routes (/api/inquiry-digest and the content
# engine's background worker). Vercel sends it as "Authorization: Bearer ...".
# Fail-secure: with this unset, those routes reject every bearer request — so
# content runs queue but never start.
CRON_SECRET=

# AI email assistant (Claude). Defaults are in lib/ai/emailModel.ts —
# claude-sonnet-5-5 at low effort — so these are only needed to override.
CLAUDE_EMAIL_MODEL=
CLAUDE_EMAIL_EFFORT=

# Application-level spend target for email drafting. NOT an Anthropic billing
# cap: it warns, and only refuses requests when ENFORCE is explicitly "true".
AI_EMAIL_MONTHLY_BUDGET_USD=5
AI_EMAIL_BUDGET_WARNING_PERCENT=80
AI_EMAIL_BUDGET_ENFORCE=false
